NODE_ENV=production

# URL p\u00fablica (local)
URL=http://localhost:3000
PORT=3000

# Secretos generados con `openssl rand -hex 32`
SECRET_KEY=e27a9d1c724dab5c732faadfafc9fbda90e62993f86574f99839b9ad759f13be
UTILS_SECRET=271719e14bdcf74f23c29b390ce4ad551c901d745a6e7690a82b97ee2200fcad

DEFAULT_LANGUAGE=es_ES

# Base de datos y Redis (apuntan a los servicios del compose)
DATABASE_URL=postgres://user:pass@postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

# Almacenamiento local
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# SSL / proxy
FORCE_HTTPS=false

# Rate limiter
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60

# Actualizaciones y logs
ENABLE_UPDATES=true
LOG_LEVEL=info

# –––– AUTENTICACI\u00d3N ––––
# Outline requiere AL MENOS un proveedor configurado para poder iniciar sesi\u00f3n.
# Rellena uno de los bloques siguientes (Google, Slack, Azure, Discord, OIDC).
# Docs: https://docs.getoutline.com/s/hosting/category/authentication
#
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_RESOURCE_APP_ID=
#
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTH_URI=
# OIDC_TOKEN_URI=
# OIDC_USERINFO_URI=
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_DISPLAY_NAME=OpenID Connect
# OIDC_SCOPES=openid profile email

# –––– SMTP (opcional) ––––
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
